<Window
    x:Class="PCGet.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PCGet">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Background="Transparent">
            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                Margin="12,0,0,0"
                VerticalAlignment="Center">
                <Image
                    Width="16"
                    Height="16"
                    Source="/Assets/PCGetSmall.ico"
                    Stretch="Uniform" />
                <TextBlock
                    Text="PCGet"
                    VerticalAlignment="Center"
                    FontSize="12" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="NavigationView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            IsPaneToggleButtonVisible="True"
            PaneDisplayMode="Auto"
            OpenPaneLength="220"
            SelectionChanged="NavigationView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Uid="Navigation_Updates"
                    Icon="Sync"
                    Tag="Updates"
                    IsSelected="True" />
                <NavigationViewItem
                    x:Uid="Navigation_Installed"
                    Icon="AllApps"
                    Tag="Installed" />
                <NavigationViewItem
                    x:Uid="Navigation_Discover"
                    Icon="Find"
                    Tag="Discover" />
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>

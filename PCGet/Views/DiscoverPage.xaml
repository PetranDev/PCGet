<Page
    x:Class="PCGet.Views.DiscoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PCGet.Models">
    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock
                Text="Discover"
                Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Search for applications and install them with WinGet."
                Style="{StaticResource BodyTextBlockStyle}"
                Opacity="0.7" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="0"
                PlaceholderText="Search applications"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                QuerySubmitted="SearchBox_QuerySubmitted" />

            <ComboBox
                Grid.Column="2"
                ItemsSource="{x:Bind ViewModel.Sources, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedSource, Mode=TwoWay}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />

            <ComboBox
                Grid.Column="4"
                ItemsSource="{x:Bind ViewModel.SortOptions, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />

            <Button
                Grid.Column="6"
                Content="Search"
                Command="{x:Bind ViewModel.SearchCommand}" />

            <Button
                Grid.Column="8"
                Command="{x:Bind ViewModel.RefreshCommand}"
                IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                ToolTipService.ToolTip="Refresh current search">
                <FontIcon Glyph="&#xE72C;" />
            </Button>
        </Grid>

        <StackPanel
            Grid.Row="4"
            Orientation="Horizontal"
            Spacing="12">
            <ProgressRing
                Width="20"
                Height="20"
                IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}" />
            <TextBlock
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
        </StackPanel>

        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="6"
            IsOpen="False"
            Severity="Error"
            Title="PCGet error" />

        <Grid
            x:Name="ResultsGrid"
            Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    x:Name="ResultsColumn"
                    Width="3*"
                    MinWidth="350" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition
                    x:Name="DetailsColumn"
                    Width="2*"
                    MinWidth="300" />
            </Grid.ColumnDefinitions>

            <ListView
                Grid.Column="0"
                ItemsSource="{x:Bind ViewModel.Packages, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedPackage, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DiscoverPackageInfo">
                        <Grid
                            Padding="8"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>

                            <Grid
                                Grid.Column="0"
                                Width="44"
                                Height="44"
                                VerticalAlignment="Top">
                                <Border
                                    CornerRadius="6"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                                <FontIcon
                                    Glyph="&#xE71D;"
                                    FontSize="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Opacity="0.6"
                                    Visibility="{x:Bind HasNoIcon}" />
                                <Image
                                    Width="38"
                                    Height="38"
                                    Source="{Binding IconUrl}"
                                    Stretch="Uniform"
                                    Visibility="{x:Bind HasIcon}" />
                            </Grid>

                            <StackPanel
                                Grid.Column="1"
                                Spacing="3">
                                <TextBlock
                                    Text="{x:Bind Name}"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="{x:Bind Publisher}"
                                    FontSize="12"
                                    Opacity="0.7"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{x:Bind HasPublisher}" />
                                <TextBlock
                                    Text="{x:Bind ShortDescription}"
                                    FontSize="12"
                                    Opacity="0.7"
                                    TextWrapping="Wrap"
                                    MaxLines="2"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{x:Bind HasDescription}" />
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <TextBlock
                                        Text="{x:Bind Id}"
                                        FontSize="11"
                                        Opacity="0.5"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind Version}"
                                        FontSize="11"
                                        Opacity="0.5" />
                                    <TextBlock
                                        Text="{x:Bind Source}"
                                        FontSize="11"
                                        Opacity="0.5" />
                                </StackPanel>
                                <StackPanel
                                    Spacing="4"
                                    Visibility="{x:Bind IsInstalling, Mode=OneWay}">
                                    <TextBlock
                                        Text="{x:Bind InstallStatus, Mode=OneWay}"
                                        FontSize="12"
                                        Opacity="0.7" />
                                    <ProgressBar
                                        Minimum="0"
                                        Maximum="100"
                                        Value="{x:Bind InstallProgress, Mode=OneWay}"
                                        IsIndeterminate="{x:Bind IsInstallIndeterminate, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>

                            <Button
                                Grid.Column="2"
                                Content="{x:Bind InstallButtonText, Mode=OneWay}"
                                IsEnabled="{x:Bind IsInstallEnabled, Mode=OneWay}"
                                Tag="{x:Bind}"
                                Click="InstallButton_Click"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Thumb
                Grid.Column="1"
                Width="8"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                DragDelta="Splitter_DragDelta"
                PointerEntered="Splitter_PointerEntered"
                PointerExited="Splitter_PointerExited"
                Visibility="{x:Bind ViewModel.HasSelectedPackage, Mode=OneWay}">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Border
                                Width="1"
                                HorizontalAlignment="Center"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <Border
                Grid.Column="2"
                Padding="24"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.HasSelectedPackage, Mode=OneWay}">
                <ScrollViewer>
                    <StackPanel
                        Spacing="20"
                        DataContext="{x:Bind ViewModel.SelectedPackage, Mode=OneWay}">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="16">
                            <Grid
                                Width="72"
                                Height="72">
                                <Border
                                    CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                                <FontIcon
                                    Glyph="&#xE71D;"
                                    FontSize="32"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Opacity="0.6"
                                    Visibility="{Binding HasNoIcon}" />
                                <Image
                                    Width="64"
                                    Height="64"
                                    Source="{Binding IconUrl}"
                                    Stretch="Uniform"
                                    Visibility="{Binding HasIcon}" />
                            </Grid>
                            <StackPanel
                                VerticalAlignment="Center"
                                Spacing="4">
                                <TextBlock
                                    Text="{Binding Name}"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{Binding Publisher}"
                                    Opacity="0.7"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding HasPublisher}" />
                            </StackPanel>
                        </StackPanel>

                        <Button
                            Content="{Binding InstallButtonText}"
                            IsEnabled="{Binding IsInstallEnabled}"
                            Tag="{Binding}"
                            Click="InstallButton_Click"
                            HorizontalAlignment="Stretch" />

                        <StackPanel
                            Spacing="6"
                            Visibility="{Binding IsInstalling}">
                            <TextBlock
                                Text="{Binding InstallStatus}"
                                Opacity="0.7" />
                            <ProgressBar
                                Minimum="0"
                                Maximum="100"
                                Value="{Binding InstallProgress}"
                                IsIndeterminate="{Binding IsInstallIndeterminate}" />
                        </StackPanel>

                        <TextBlock
                            Text="{Binding DisplayDescription}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True"
                            Visibility="{Binding HasDescription}" />

                        <StackPanel Spacing="12">
                            <TextBlock
                                Text="Package information"
                                FontSize="18"
                                FontWeight="SemiBold" />
                            <Grid ColumnSpacing="16" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="Version"
                                    Opacity="0.6" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding Version}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="Source"
                                    Opacity="0.6" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding Source}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Text="Package ID"
                                    Opacity="0.6" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Text="{Binding Id}"
                                    TextWrapping="Wrap"
                                    IsTextSelectionEnabled="True" />
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Text="License"
                                    Opacity="0.6"
                                    Visibility="{Binding HasLicense}" />
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Text="{Binding License}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding HasLicense}" />
                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Text="Tags"
                                    Opacity="0.6"
                                    Visibility="{Binding HasTags}" />
                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Text="{Binding Tags}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding HasTags}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel
                            Spacing="8"
                            Visibility="{Binding HasLinks}">
                            <TextBlock
                                Text="Links"
                                FontSize="18"
                                FontWeight="SemiBold" />
                            <Button
                                Content="Package website"
                                Tag="{Binding PackageUrl}"
                                Click="LinkButton_Click"
                                HorizontalAlignment="Left"
                                Visibility="{Binding HasPackageUrl}" />
                            <Button
                                Content="Publisher website"
                                Tag="{Binding PublisherUrl}"
                                Click="LinkButton_Click"
                                HorizontalAlignment="Left"
                                Visibility="{Binding HasPublisherUrl}" />
                            <Button
                                Content="License"
                                Tag="{Binding LicenseUrl}"
                                Click="LinkButton_Click"
                                HorizontalAlignment="Left"
                                Visibility="{Binding HasLicenseUrl}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
<Page
    x:Class="PCGet.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="32" MaxWidth="1000" HorizontalAlignment="Left">
            <StackPanel Spacing="8">
                <TextBlock x:Uid="Settings_Title" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Uid="Settings_Subtitle" Style="{StaticResource BodyTextBlockStyle}" Opacity="0.7" />
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock x:Uid="Settings_PackageOperations" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Padding="20" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock x:Uid="Settings_SilentOperations" FontWeight="SemiBold" />
                            <TextBlock x:Uid="Settings_SilentOperationsDescription" TextWrapping="Wrap" Opacity="0.7" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.SilentPackageOperations, Mode=TwoWay}" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock x:Uid="Common_Updates" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Padding="20" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="20">
                        <Grid ColumnSpacing="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock x:Uid="Settings_CheckStartup" FontWeight="SemiBold" />
                                <TextBlock x:Uid="Settings_CheckStartupDescription" TextWrapping="Wrap" Opacity="0.7" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.CheckUpdatesOnStartup, Mode=TwoWay}" />
                        </Grid>

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <Grid ColumnSpacing="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock x:Uid="Settings_BackgroundChecks" FontWeight="SemiBold" />
                                <TextBlock x:Uid="Settings_BackgroundChecksDescription" TextWrapping="Wrap" Opacity="0.7" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsOn="{x:Bind ViewModel.BackgroundUpdateChecks, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnSpacing="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock x:Uid="Settings_CheckInterval" FontWeight="SemiBold" />
                                <TextBlock x:Uid="Settings_CheckIntervalDescription" TextWrapping="Wrap" Opacity="0.7" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.BackgroundUpdateIntervals}" SelectedItem="{x:Bind ViewModel.SelectedBackgroundUpdateInterval, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.BackgroundUpdateChecks, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock x:Uid="Settings_Language" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Padding="20" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock x:Uid="Settings_AppLanguage" FontWeight="SemiBold" />
                            <TextBlock x:Uid="Settings_AppLanguageDescription" TextWrapping="Wrap" Opacity="0.7" />
                            <TextBlock Text="{x:Bind ViewModel.LanguageRestartStatus, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Opacity="0.6" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.Languages}" SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock x:Uid="Settings_WindowsStartup" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Padding="20" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock x:Uid="Settings_StartWithWindows" FontWeight="SemiBold" />
                            <TextBlock x:Uid="Settings_StartWithWindowsDescription" TextWrapping="Wrap" Opacity="0.7" />
                            <TextBlock Text="{x:Bind ViewModel.StartupStatus, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Opacity="0.6" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsEnabled="{x:Bind ViewModel.CanChangeStartWithWindows, Mode=OneWay}" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock x:Uid="Settings_AdvancedArguments" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Padding="20" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="20">
                        <TextBlock x:Uid="Settings_AdvancedArgumentsDescription" TextWrapping="Wrap" Opacity="0.7" />

                        <TextBox
                            x:Uid="Settings_InstallArgumentsBox"
                            Text="{x:Bind ViewModel.InstallAdditionalArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBox
                            x:Uid="Settings_UpdateArgumentsBox"
                            Text="{x:Bind ViewModel.UpdateAdditionalArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBox
                            x:Uid="Settings_UninstallArgumentsBox"
                            Text="{x:Bind ViewModel.UninstallAdditionalArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock x:Uid="Settings_PackageSources" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Padding="20" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Settings_WinGetSources" FontWeight="SemiBold" />
                        <TextBlock x:Uid="Settings_WinGetSourcesDescription" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock x:Uid="Settings_About" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border Padding="20" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Width="48" Height="48" Source="/Assets/PCGet.ico" Stretch="Uniform" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="PCGet" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Uid="Settings_Tagline" Opacity="0.7" />
                            <TextBlock Text="{x:Bind ViewModel.VersionText}" FontSize="12" Opacity="0.6" />
                            <TextBlock x:Uid="Settings_PoweredBy" FontSize="12" Opacity="0.5" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

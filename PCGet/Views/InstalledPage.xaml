<Page
    x:Class="PCGet.Views.InstalledPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PCGet.Models">
    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="8">
                <TextBlock
                    Text="Installed"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="Applications managed by WinGet."
                    Style="{StaticResource BodyTextBlockStyle}"
                    Opacity="0.7" />
            </StackPanel>

            <Button
                x:Name="UninstallSelectedButton"
                Grid.Column="1"
                Content="Uninstall selected"
                IsEnabled="False"
                Click="UninstallSelectedButton_Click" />

            <Button
                Grid.Column="3"
                Content="Refresh"
                Command="{x:Bind ViewModel.RefreshCommand}" />
        </Grid>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="12">
            <ProgressRing
                Width="20"
                Height="20"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <TextBlock
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            <TextBlock
                x:Name="SelectionStatusText"
                VerticalAlignment="Center"
                Opacity="0.7" />
        </StackPanel>

        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="4"
            IsOpen="False"
            Severity="Error"
            Title="PCGet error" />

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                Grid.Column="0"
                PlaceholderText="Search installed applications"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ComboBox
                Grid.Column="2"
                ItemsSource="{x:Bind ViewModel.Sources}"
                SelectedItem="{x:Bind ViewModel.SelectedSource, Mode=TwoWay}"
                HorizontalAlignment="Stretch" />

            <ComboBox
                Grid.Column="4"
                ItemsSource="{x:Bind ViewModel.SortOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}"
                HorizontalAlignment="Stretch" />
        </Grid>

        <ListView
            x:Name="PackagesListView"
            Grid.Row="8"
            ItemsSource="{x:Bind ViewModel.Packages, Mode=OneWay}"
            SelectionMode="Multiple"
            SelectionChanged="PackagesListView_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:PackageInfo">
                    <Grid Padding="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            Spacing="4">
                            <TextBlock
                                Text="{x:Bind Name}"
                                FontSize="16"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{x:Bind Id}"
                                Opacity="0.6"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind InstalledVersion}"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Grid.Column="2"
                            Text="{x:Bind Source}"
                            VerticalAlignment="Center"
                            Opacity="0.6" />

                        <StackPanel
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Spacing="6">
                            <Button
                                Content="{x:Bind UninstallButtonText, Mode=OneWay}"
                                IsEnabled="{x:Bind IsUninstallEnabled, Mode=OneWay}"
                                Tag="{x:Bind}"
                                Click="UninstallButton_Click"
                                HorizontalAlignment="Stretch" />

                            <StackPanel
                                Spacing="4"
                                Visibility="{x:Bind IsUninstalling, Mode=OneWay}">
                                <ProgressBar
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{x:Bind UninstallProgress, Mode=OneWay}"
                                    IsIndeterminate="{x:Bind IsUninstallIndeterminate, Mode=OneWay}" />
                                <TextBlock
                                    Text="{x:Bind UninstallStatus, Mode=OneWay}"
                                    HorizontalAlignment="Center"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    FontSize="12"
                                    Opacity="0.7" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
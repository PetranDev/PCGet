<Page
    x:Class="AppDeck.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel
            Padding="32"
            Spacing="32">
            <StackPanel Spacing="8">
                <TextBlock
                    Text="Settings"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="Configure how AppDeck manages your applications."
                    Style="{StaticResource BodyTextBlockStyle}"
                    Opacity="0.7" />
            </StackPanel>
            <StackPanel Spacing="12">
                <TextBlock
                    Text="Package operations"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border
                    Padding="16"
                    CornerRadius="8"
                    BorderThickness="1">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Column="0"
                            Spacing="4">
                            <TextBlock
                                Text="Silent package operations"
                                FontWeight="SemiBold" />
                            <TextBlock
                                Text="Install, update, and uninstall applications without showing their installer interface when supported."
                                TextWrapping="Wrap"
                                Opacity="0.7" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsOn="{x:Bind ViewModel.SilentPackageOperations, Mode=TwoWay}" />
                    </Grid>
                </Border>
            </StackPanel>
            <StackPanel Spacing="12">
                <TextBlock
                    Text="Updates"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border
                    Padding="16"
                    CornerRadius="8"
                    BorderThickness="1">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Column="0"
                            Spacing="4">
                            <TextBlock
                                Text="Check for updates on startup"
                                FontWeight="SemiBold" />
                            <TextBlock
                                Text="Automatically check for available package updates when AppDeck starts."
                                TextWrapping="Wrap"
                                Opacity="0.7" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsOn="{x:Bind ViewModel.CheckUpdatesOnStartup, Mode=TwoWay}" />
                    </Grid>
                </Border>
            </StackPanel>
            <StackPanel Spacing="12">
                <TextBlock
                    Text="Package sources"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border
                    Padding="16"
                    CornerRadius="8"
                    BorderThickness="1">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Column="0"
                            Spacing="4">
                            <TextBlock
                                Text="WinGet sources"
                                FontWeight="SemiBold" />
                            <TextBlock
                                Text="AppDeck currently uses the package sources configured in Windows Package Manager."
                                TextWrapping="Wrap"
                                Opacity="0.7" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Content="Manage"
                            VerticalAlignment="Center"
                            IsEnabled="False" />
                    </Grid>
                </Border>
            </StackPanel>
            <StackPanel Spacing="12">
                <TextBlock
                    Text="About"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <Border
                    Padding="16"
                    CornerRadius="8"
                    BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="AppDeck"
                            FontSize="18"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="Your Windows apps. One place."
                            Opacity="0.7" />
                        <TextBlock
                            Text="Powered by Windows Package Manager"
                            FontSize="12"
                            Opacity="0.5" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
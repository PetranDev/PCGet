<Page
    x:Class="AppDeck.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel
            Padding="32"
            Spacing="32"
            MaxWidth="1000"
            HorizontalAlignment="Left">

            <StackPanel Spacing="8">
                <TextBlock
                    Text="Settings"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="Configure how AppDeck manages your applications."
                    Style="{StaticResource BodyTextBlockStyle}"
                    Opacity="0.7" />
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock
                    Text="Package operations"
                    Style="{StaticResource SubtitleTextBlockStyle}" />

                <Border
                    Padding="20"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock
                                Text="Silent package operations"
                                FontWeight="SemiBold" />
                            <TextBlock
                                Text="Install, update, and uninstall applications without showing their installer interface when supported."
                                TextWrapping="Wrap"
                                Opacity="0.7" />
                        </StackPanel>

                        <ToggleSwitch
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsOn="{x:Bind ViewModel.SilentPackageOperations, Mode=TwoWay}" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock
                    Text="Updates"
                    Style="{StaticResource SubtitleTextBlockStyle}" />

                <Border
                    Padding="20"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="20">

                        <Grid ColumnSpacing="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock
                                    Text="Check for updates on startup"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="Automatically check for available package updates when AppDeck starts."
                                    TextWrapping="Wrap"
                                    Opacity="0.7" />
                            </StackPanel>

                            <ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsOn="{x:Bind ViewModel.CheckUpdatesOnStartup, Mode=TwoWay}" />
                        </Grid>

                        <Rectangle
                            Height="1"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <Grid ColumnSpacing="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock
                                    Text="Check for updates in the background"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="Periodically check for package updates while AppDeck is running."
                                    TextWrapping="Wrap"
                                    Opacity="0.7" />
                            </StackPanel>

                            <ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsOn="{x:Bind ViewModel.BackgroundUpdateChecks, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnSpacing="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock
                                    Text="Check interval"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="Choose how often AppDeck checks for available updates."
                                    TextWrapping="Wrap"
                                    Opacity="0.7" />
                            </StackPanel>

                            <ComboBox
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind ViewModel.BackgroundUpdateIntervals}"
                                SelectedItem="{x:Bind ViewModel.SelectedBackgroundUpdateInterval, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.BackgroundUpdateChecks, Mode=OneWay}" />
                        </Grid>

                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock
                    Text="Windows startup"
                    Style="{StaticResource SubtitleTextBlockStyle}" />

                <Border
                    Padding="20"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock
                                Text="Start AppDeck with Windows"
                                FontWeight="SemiBold" />
                            <TextBlock
                                Text="Automatically launch AppDeck when you sign in to Windows."
                                TextWrapping="Wrap"
                                Opacity="0.7" />
                            <TextBlock
                                Text="{x:Bind ViewModel.StartupStatus, Mode=OneWay}"
                                TextWrapping="Wrap"
                                FontSize="12"
                                Opacity="0.6" />
                        </StackPanel>

                        <ToggleSwitch
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsEnabled="{x:Bind ViewModel.CanChangeStartWithWindows, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock
                    Text="Package sources"
                    Style="{StaticResource SubtitleTextBlockStyle}" />

                <Border
                    Padding="20"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Text="WinGet sources"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="AppDeck uses the package sources configured in Windows Package Manager."
                            TextWrapping="Wrap"
                            Opacity="0.7" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock
                    Text="About"
                    Style="{StaticResource SubtitleTextBlockStyle}" />

                <Border
                    Padding="20"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image
                            Grid.Column="0"
                            Width="48"
                            Height="48"
                            Source="/Assets/AppDeck.ico"
                            Stretch="Uniform"
                            VerticalAlignment="Top" />

                        <StackPanel
                            Grid.Column="1"
                            Spacing="4"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="AppDeck"
                                FontSize="18"
                                FontWeight="SemiBold" />
                            <TextBlock
                                Text="Your Windows apps. One place."
                                Opacity="0.7" />
                            <TextBlock
                                Text="{x:Bind ViewModel.VersionText}"
                                FontSize="12"
                                Opacity="0.6" />
                            <TextBlock
                                Text="Powered by Windows Package Manager"
                                FontSize="12"
                                Opacity="0.5" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
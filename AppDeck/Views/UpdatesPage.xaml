<Page
    x:Class="AppDeck.Views.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AppDeck.Models">
    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8">
                <TextBlock
                    Text="Updates"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="Keep your installed applications up to date."
                    Style="{StaticResource BodyTextBlockStyle}"
                    Opacity="0.7" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Content="Refresh"
                    Command="{x:Bind ViewModel.RefreshCommand}" />
                <Button
                    Content="Update All"
                    Command="{x:Bind ViewModel.UpdateAllCommand}"
                    IsEnabled="{x:Bind ViewModel.CanUpdateAll, Mode=OneWay}" />
            </StackPanel>
        </Grid>
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="12">
            <ProgressRing
                Width="20"
                Height="20"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <TextBlock
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
        </StackPanel>
        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="4"
            IsOpen="False"
            Severity="Error"
            Title="WinGet operation failed" />
        <ListView
            Grid.Row="6"
            ItemsSource="{x:Bind ViewModel.Updates, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:PackageInfo">
                    <Grid Padding="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Column="0"
                            Spacing="4">
                            <TextBlock
                                Text="{x:Bind Name}"
                                FontSize="16"
                                FontWeight="SemiBold" />
                            <TextBlock
                                Text="{x:Bind Id}"
                                Opacity="0.6" />
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">
                                <TextBlock Text="{x:Bind InstalledVersion}" />
                                <TextBlock Text="→" />
                                <TextBlock
                                    Text="{x:Bind AvailableVersion}"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="{x:Bind Source}"
                                    Opacity="0.6"
                                    Margin="12,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Spacing="6">
                            <Button
                                Content="{x:Bind UpdateButtonText, Mode=OneWay}"
                                Tag="{x:Bind}"
                                Click="UpdateButton_Click"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind IsUpdateEnabled, Mode=OneWay}" />
                            <ProgressBar
                                Minimum="0"
                                Maximum="100"
                                Value="{x:Bind UpdateProgress, Mode=OneWay}"
                                IsIndeterminate="{x:Bind IsUpdateIndeterminate, Mode=OneWay}" />
                            <TextBlock
                                Text="{x:Bind UpdateStatus, Mode=OneWay}"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Opacity="0.7" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
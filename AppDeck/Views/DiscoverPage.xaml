<Page
    x:Class="AppDeck.Views.DiscoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AppDeck.Models">
    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock
                Text="Discover"
                Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Search for applications and install them with WinGet."
                Style="{StaticResource BodyTextBlockStyle}"
                Opacity="0.7" />
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="0"
                PlaceholderText="Search applications"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                QuerySubmitted="SearchBox_QuerySubmitted" />
            <Button
                Grid.Column="2"
                Content="Search"
                Command="{x:Bind ViewModel.SearchCommand}" />
        </Grid>
        <StackPanel
            Grid.Row="4"
            Orientation="Horizontal"
            Spacing="12">
            <ProgressRing
                Width="20"
                Height="20"
                IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}" />
            <TextBlock
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
        </StackPanel>
        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="6"
            IsOpen="False"
            Severity="Error"
            Title="AppDeck error" />
        <ListView
            Grid.Row="8"
            ItemsSource="{x:Bind ViewModel.Packages, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:DiscoverPackageInfo">
                    <Grid Padding="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Column="0"
                            Spacing="4">
                            <TextBlock
                                Text="{x:Bind Name}"
                                FontSize="16"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{x:Bind Id}"
                                Opacity="0.6"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel
                                Spacing="4"
                                Visibility="{x:Bind IsInstalling, Mode=OneWay}">
                                <TextBlock
                                    Text="{x:Bind InstallStatus, Mode=OneWay}"
                                    FontSize="12"
                                    Opacity="0.7" />
                                <ProgressBar
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{x:Bind InstallProgress, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind Version}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Grid.Column="2"
                            Text="{x:Bind Source}"
                            VerticalAlignment="Center"
                            Opacity="0.6" />
                        <Button
                            Grid.Column="3"
                            Content="{x:Bind InstallButtonText, Mode=OneWay}"
                            IsEnabled="{x:Bind IsInstallEnabled, Mode=OneWay}"
                            Tag="{x:Bind}"
                            Click="InstallButton_Click"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
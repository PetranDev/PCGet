<Window
    x:Class="AppDeck.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AppDeck"
    xmlns:views="using:AppDeck.Views"
    Title="AppDeck">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Background="Transparent">
            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                Margin="12,0,0,0"
                VerticalAlignment="Center">
                <Image
                    Width="16"
                    Height="16"
                    Source="Assets/AppDeck.ico"
                    Stretch="Uniform" />
                <TextBlock
                    Text="AppDeck"
                    VerticalAlignment="Center"
                    FontSize="12" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="NavigationView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            PaneDisplayMode="Left"
            SelectionChanged="NavigationView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="Updates"
                    Icon="Sync"
                    Tag="Updates"
                    IsSelected="True" />
                <NavigationViewItem
                    Content="Installed"
                    Icon="AllApps"
                    Tag="Installed" />
                <NavigationViewItem
                    Content="Discover"
                    Icon="Find"
                    Tag="Discover" />
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>